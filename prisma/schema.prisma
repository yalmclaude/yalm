// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum DepositType {
  FIXED
  PERCENT
}

enum BookingStatus {
  PENDING_DEPOSIT
  CONFIRMED
  CANCELLED
  EXPIRED
}

model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  categoryId    String
  category      Category       @relation(fields: [categoryId], references: [id])
  description   String
  priceCents    Int
  depositType   DepositType
  depositValue  Int
  totalQuantity    Int            @default(1)
  isAvailable      Boolean        @default(true)
  allowFullPayment Boolean        @default(false)
  cautionCents     Int            @default(0)
  durationOptions  Json           @default("[]")
  quoteOnly        Boolean        @default(false)
  saleMode           String         @default("RENT") // RENT | BUY | BOTH
  purchasePriceCents Int            @default(0)
  askCustomText      Boolean        @default(false) // client writes the text to display (miroir, plexiglas…)
  createdAt        DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bookings      Booking[]
  packItems     PackItem[]
  images        ProductImage[]
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, order])
}

model Pack {
  id            String      @id @default(cuid())
  slug          String      @unique
  name          String
  description   String
  priceCents    Int
  depositType   DepositType
  depositValue  Int
  imageUrl         String?
  isAvailable      Boolean     @default(true)
  allowFullPayment Boolean     @default(false)
  cautionCents     Int         @default(0)
  durationOptions  Json        @default("[]")
  quoteOnly        Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         PackItem[]
  bookings      Booking[]
}

model PackItem {
  id        String  @id @default(cuid())
  packId    String
  pack      Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  @@unique([packId, productId])
}

model HowItWorksStep {
  id          String @id @default(cuid())
  order       Int    @default(0)
  title       String
  description String
}

model Booking {
  id                    String        @id @default(cuid())
  productId             String?
  product               Product?      @relation(fields: [productId], references: [id])
  packId                String?
  pack                  Pack?         @relation(fields: [packId], references: [id])
  customerName          String
  email                 String
  phone                 String
  eventDate             DateTime
  quantity              Int           @default(1)
  status                BookingStatus @default(PENDING_DEPOSIT)
  depositAmountCents    Int
  totalCents            Int           @default(0)
  cautionCents          Int           @default(0)
  durationHours         Float?
  purchase              Boolean       @default(false)
  cautionLater          Boolean       @default(false)
  customText            String        @default("")
  items                 Json?
  label                 String        @default("") // title shown instead of the product (ex. "Devis DEV-2026-001")
  quoteId               String?
  payToken              String?       @unique // link /paiement/<token> to pay the balance
  balanceRequestedAt    DateTime?
  balancePaidAt         DateTime?
  cautionPaidAt         DateTime?
  stripeSessionId       String?
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([productId, eventDate])
  @@index([packId, eventDate])
}

model Coffret {
  id         String   @id @default(cuid())
  slug       String   @unique
  names      String   @default("")
  date       String   @default("")
  location   String   @default("")
  username   String   @default("")
  code       String   @default("")
  cover      String   @default("")
  final      String   @default("")
  showQuotes Boolean  @default(true)
  categories String[] @default(["Préparatifs", "Cérémonie", "Couple", "Cocktail", "Dîner", "Soirée", "Détails"])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  photos   CoffretPhoto[]
  videos   CoffretVideo[]
  messages CoffretMessage[]
  products CoffretProduct[]

  @@index([username, code])
}

model CoffretPhoto {
  id        String  @id @default(cuid())
  coffretId String
  coffret   Coffret @relation(fields: [coffretId], references: [id], onDelete: Cascade)
  category  String  @default("")
  src       String  @default("")
  order     Int     @default(0)

  @@index([coffretId, order])
}

model CoffretVideo {
  id        String  @id @default(cuid())
  coffretId String
  coffret   Coffret @relation(fields: [coffretId], references: [id], onDelete: Cascade)
  title     String  @default("")
  duration  String  @default("")
  thumb     String  @default("")
  src       String  @default("")
  order     Int     @default(0)

  @@index([coffretId, order])
}

model CoffretMessage {
  id        String  @id @default(cuid())
  coffretId String
  coffret   Coffret @relation(fields: [coffretId], references: [id], onDelete: Cascade)
  name      String  @default("")
  duration  Int     @default(30)
  quote     String  @default("")
  src       String  @default("")
  order     Int     @default(0)

  @@index([coffretId, order])
}

model CoffretProduct {
  id          String  @id @default(cuid())
  coffretId   String
  coffret     Coffret @relation(fields: [coffretId], references: [id], onDelete: Cascade)
  name        String  @default("")
  price       String  @default("")
  description String  @default("")
  image       String  @default("")
  link        String  @default("")
  order       Int     @default(0)

  @@index([coffretId, order])
}

// Site-wide settings stored as JSON by key (e.g. "customFormula").
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum QuoteStatus {
  SENT
  ACCEPTED
  CANCELLED
}

// Devis sent from the admin: the client accepts it online by paying the deposit, which creates a booking.
model Quote {
  id             String      @id @default(cuid())
  number         String      @unique // DEV-2026-001
  token          String      @unique // public link /devis/<token>
  customerName   String
  email          String
  phone          String      @default("")
  eventDate      DateTime
  lines          Json        // [{ label, description, priceCents }] — prices TTC
  depositPercent Int         @default(40)
  cautionCents   Int         @default(0)
  note           String      @default("")
  validUntil     DateTime
  status         QuoteStatus @default(SENT)
  bookingId      String?
  stripeSessionId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}
